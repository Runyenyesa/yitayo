{
  "name": "yitayo-backend",
  "version": "1.0.0",
  "description": "Zero-Hardware Crowdsourced Transit Grid — Production Backend for Kayoola EVS Fleet",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "db:migrate": "psql $DATABASE_URL -f database/schema.sql",
    "db:seed": "node database/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "jest --coverage"
  },
  "keywords": ["transit", "uganda", "ev-fleet", "crowdsourced-gps", "kayoola"],
  "author": "Yitayo Engineering Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "dotenv": "^16.4.5",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^10.0.0",
    "socket.io": "^4.7.5",
    "node-cron": "^3.0.3",
    "winston": "^3.13.1",
    "joi": "^17.13.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}