# ==========================================
# YITAYO BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Server
PORT=3000
NODE_ENV=production

# PostgreSQL Database
DATABASE_URL=postgresql://yitayo_user:yitayo_secure_pass@localhost:5432/yitayo_db
# Or split:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=yitayo_db
# DB_USER=yitayo_user
# DB_PASSWORD=yitayo_secure_pass
# DB_SSL=false

# JWT Secrets
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_long
JWT_EXPIRES_IN=8h

# Admin Dashboard Auth
ADMIN_API_KEY=yt_admin_prod_key_change_this

# Algorithm Tuning
TELEMETRY_AGGREGATION_WINDOW_SEC=30
MIN_PINGS_FOR_AGGREGATE=3
MAX_GPS_AGE_MINUTES=10
OUTLIER_STD_DEV_THRESHOLD=2.5

# Charging & Lockdown
CHARGING_HANDSHAKE_TIMEOUT_MIN=30
NIGHTLY_LOCK_AUTO_RADIUS_M=200

# MoWT Integration (Future)
# MOWT_API_ENDPOINT=https://api.mowt.go.ug/v1
# MOWT_API_KEY=xxx
